{
  "name": "@thebrianlopez/pi-telemetry",
  "version": "0.1.0",
  "description": "Pi coding agent extension for structured JSONL telemetry to automation-metrics event bus",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
