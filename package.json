    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.6.1",
    "@earendil-works/pi-coding-agent": "^1.6.1"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
